# 复制为 .env 后再启动: cp .env.example .env && docker compose up -d

# ---------------- 1. 宿主机持久化目录挂载 ----------------
# 默认保存在 server/data/*；可改为宿主机绝对路径（如 /var/lib/atbrains/... 或既有数据库目录）
ATBRAINS_MARIADB_DATA_DIR=./data/mariadb
ATBRAINS_REDIS_DATA_DIR=./data/redis
ATBRAINS_QDRANT_DATA_DIR=./data/qdrant
ATBRAINS_SERVER_DATA_DIR=./data/server

# ---------------- 2. 端口与监听地址 ----------------
ATBRAINS_WEB_BIND=0.0.0.0
ATBRAINS_WEB_PORT=8080
ATBRAINS_SERVER_BIND=127.0.0.1
ATBRAINS_PORT=8787
# 数据库端口默认只监听本机回环，不对外暴露 DB 口令端口
ATBRAINS_MARIADB_BIND=127.0.0.1
ATBRAINS_MARIADB_HOST_PORT=57306
ATBRAINS_REDIS_BIND=127.0.0.1
ATBRAINS_REDIS_HOST_PORT=9079
ATBRAINS_QDRANT_BIND=127.0.0.1
ATBRAINS_QDRANT_HOST_PORT=6333

# ---------------- 3. 数据库凭据（生产环境务必修改） ----------------
ATBRAINS_MARIADB_ROOT_PASSWORD=change-me-root
ATBRAINS_MARIADB_DB=agent_memory
ATBRAINS_MARIADB_USER=agent
ATBRAINS_MARIADB_PASSWORD=change-me-db
ATBRAINS_REDIS_PASSWORD=change-me-redis
ATBRAINS_REDIS_DB=0

# ---------------- 4. 向量与可选蒸馏 API ----------------
ATBRAINS_VECTOR_ENABLED=1
ATBRAINS_QDRANT_URL=http://qdrant:6333
ATBRAINS_QDRANT_COLLECTION=brain_memories
ATBRAINS_QDRANT_API_KEY=
ATBRAINS_EMBED_BASE_URL=https://api.siliconflow.cn/v1
ATBRAINS_EMBED_MODEL=Qwen/Qwen3-Embedding-4B
ATBRAINS_EMBED_DIM=2560
ATBRAINS_EMBED_API_KEY=

ATBRAINS_DISTILL_ENABLED=0
ATBRAINS_DISTILL_API_KEY=

# ---------------- 5. 构建期可选镜像源 ----------------
# PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
